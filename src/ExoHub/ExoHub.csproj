<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console: a tray icon and a window (PLAN.md, PC app). The tools
         redirect stdout and still read it; otherwise see HubLog.cs. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Exo.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ExoHub</RootNamespace>
    <!-- Declares per-monitor DPI awareness before any code runs. See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms asks for DPI in code instead; the manifest stays, since the
         awareness must be set before any display call. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- CodecApi.cs calls ICodecAPI through raw function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The pinned adb (PROJECT_SPEC FR-5.3, DECISIONS 5.8). Three files, copied
       into adb\ beside ExoHub.exe: adb.exe imports AdbWinApi.dll, which loads
       AdbWinUsbApi.dll by name. Not committed; .gitignore excludes them.
       Kept out of a single-file publish: the hub starts adb from disk. -->
  <PropertyGroup>
    <AdbSource Condition="'$(AdbSource)' == ''">$(LOCALAPPDATA)\Android\Sdk\platform-tools</AdbSource>
    <AdbRevision>37.0.1</AdbRevision>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(AdbSource)\adb.exe;$(AdbSource)\AdbWinApi.dll;$(AdbSource)\AdbWinUsbApi.dll"
          Link="adb\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>
  <Target Name="CheckPinnedAdb" BeforeTargets="BeforeBuild">
    <ReadLinesFromFile File="$(AdbSource)\source.properties">
      <Output TaskParameter="Lines" ItemName="AdbSourceProperties" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <AdbSourcePropertiesText>;@(AdbSourceProperties);</AdbSourcePropertiesText>
    </PropertyGroup>
    <Error Condition="!$(AdbSourcePropertiesText.Contains(';Pkg.Revision=$(AdbRevision);'))"
           Text="adb in $(AdbSource) is not platform-tools $(AdbRevision), the pinned revision. Set AdbSource to a $(AdbRevision) copy." />
  </Target>

  <!-- Only the UI uses these; global, Cursor and Timer would be ambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Exo.ico" LogicalName="ExoHub.Exo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
