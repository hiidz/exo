;
; ExoDisplay.inf: Exo's virtual display adapter, a user-mode IddCx driver.
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=exodisplay.cat
DriverVer= ; set by stampinf

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceName%=ExoDisplay_Install, Root\ExoDisplay

[SourceDisksFiles]
ExoDisplay.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[ExoDisplay_Install.NT]
CopyFiles=UMDriverCopy

[ExoDisplay_Install.NT.hw]
AddReg = ExoDisplay_HardwareDeviceSettings

; Its own host process. Any signed-in user may send it requests, so the
; unelevated hub can plug a monitor.
[ExoDisplay_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "ExoDisplayGroup"
HKR,, "Security",, "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;AU)"

[ExoDisplay_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[ExoDisplay_Install.NT.Wdf]
UmdfService=ExoDisplay,ExoDisplay_Install
UmdfServiceOrder=ExoDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients

[ExoDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\ExoDisplay.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
ExoDisplay.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Exo"
DiskName = "Exo Display Installation Disk"
DeviceName="Exo Display Adapter"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
