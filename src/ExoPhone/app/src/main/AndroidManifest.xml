<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The camera role. MainActivity asks for it the first time the user
         picks "Use as webcam". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Wi-Fi (PLAN.md, Wi-Fi as built in step 4): sockets to the LAN, the
         Wi-Fi network to bind them to, and Android 17's local network
         permission, asked for when the user picks Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- CameraService, so capture goes on with the screen off (D2a). The
         camera type needs its own permission from Android 14. The
         notification permission is asked for with the camera's. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- DisplayService, so a paused display keeps its connection, and
         Android its network, out of view. The connected device type needs
         its own permission and one of a list, of which CHANGE_NETWORK_STATE
         is granted at install. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- NoActionBar: the default theme draws an ActionBar over the content
         (spike 4 FINDINGS, traps). -->
    <application
        android:label="Exo"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- sensorLandscape: either landscape, whichever way up the device
             is held. A 180 degree turn keeps the size and orientation, so
             the activity is not recreated and the link stays up. The home
             screen too, so the webcam's first rotation is read in landscape
             (DECISIONS 6.4). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Its orientation is the display setting, set in onCreate. It
             handles turns itself, so the link stays up through them. -->
        <activity
            android:name=".DisplayActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false" />
        <service
            android:name=".CameraService"
            android:exported="false"
            android:foregroundServiceType="camera" />
        <service
            android:name=".DisplayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
