<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light or dark as the system's setting: values-night gives these
         two the platform's dark parents, and colors.xml its dark colours. -->
    <style name="Exo.Base" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Exo.Dialog.Base" parent="android:Theme.Material.Light.Dialog.Alert" />

    <!-- The app's screen: indigo accent, icons on the transparent system
         bars dark on light and light on dark. -->
    <style name="Exo" parent="Exo.Base">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:alertDialogTheme">@style/Exo.Dialog</item>
    </style>

    <!-- Dialogs: a 28dp surface over the scrim. -->
    <style name="Exo.Dialog" parent="Exo.Dialog.Base">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text</item>
        <item name="android:windowBackground">@drawable/dialog</item>
        <item name="android:backgroundDimAmount">@dimen/scrim</item>
        <item name="android:buttonBarButtonStyle">@style/Exo.DialogButton</item>
    </style>

    <style name="Exo.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
